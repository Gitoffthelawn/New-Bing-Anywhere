{
  "name": "new-bing-anywhere",
  "version": "3.0.0",
  "private": true,
  "description": "New Bing isn't just for Edge anymore. Anywhere you want",
  "homepage": "https://github.com/ha0z1/New-Bing-Anywhere",
  "repository": {
    "type": "git",
    "url": "https://github.com/ha0z1/New-Bing-Anywhere"
  },
  "license": "GPLv3",
  "author": "haozi",
  "workspaces": [
    "packages/*",
    "src/app",
    "global"
  ],
  "scripts": {
    "build": "bun run lint && bun run scripts/build.ts build",
    "copy": "rm -rf dist && cp -r public dist",
    "copy:source": "rsync -vhra . dist/source --include='**.gitignore' --exclude='/.git' --exclude='dist'  --filter=':- .gitignore' --delete-after",
    "copy:watch": "bun run copy -- --watch",
    "dev": "bun run lint && bun run scripts/build.ts dev",
    "lint": "bun run prettier && bun run lint:eslint && bun run lint:stylus",
    "lint:eslint": "eslint --ext .js,.ts ./src --fix --cache",
    "lint:stylus": "stylus-supremacy format '{src,global}/**/*.styl' --options ./stylus-supremacy.json --replace",
    "prepare": "husky install && bun run build",
    "prettier": "prettier --cache --write '.'",
    "prettier:watch": "onchange \"**/*\" -- prettier --cache --write --ignore-unknown --ignore-path .prettierignore {{changed}} > /dev/null 2>&1",
    "test": "bun run lint"
  },
  "dependencies": {
    "@ha0z1/extension-utils": "workspace:*",
    "@ha0z1/llama-apis": "workspace:*",
    "global": "workspace:*",
    "idmp": "^3.6.5",
    "jquery": "^3.7.1",
    "lodash-es": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/chrome": "^0.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jquery": "^3.5.32",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/webextension-polyfill": "^0.12.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "bun": "^1.2.19",
    "copy-and-watch": "^0.1.8",
    "eslint": "^9.33.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "md5-file": "^5.0.0",
    "onchange": "^7.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-lint-md": "^1.0.1",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-copy": "^3.5.0",
    "sort-package-json": "^3.4.0",
    "stylus": "^0.64.0",
    "stylus-supremacy": "^4.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-imp": "^2.4.0"
  },
  "extensionName": "New Bing Anywhere (Bing Chat GPT-5)"
}
